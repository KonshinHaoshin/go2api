# go2api-web configuration
# Copy this file to `.env` and edit before running.
# All values shown here are the defaults; delete any line you don't want to override.

# Port the web UI listens on
PORT=8081

# Upstream go2api backend
GO2API_URL=http://localhost:8080
# Token used by the web server when forwarding requests to go2api.
# Must match one of the auth_tokens listed in the go2api config.yaml.
GO2API_TOKEN=change-me-please

# Admin login credentials (used by the /api/auth/login endpoint)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# JWT signing secret. If left blank, a random secret is generated at startup
# and all previously issued tokens are invalidated on restart.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# JWT lifetime, e.g. "12h", "7d", "1h"
JWT_EXPIRES_IN=12h